	"type": "module",
	"main": "./build/main.js",
	"scripts": {
		"start:main": "cross-env NODE_ENV=development NODE_OPTIONS=\"--import tsx\" electronmon ./src/main/index.ts",
		"start:preload": "rimraf build/preload.js && cross-env NODE_ENV=development NODE_OPTIONS=\"--import tsx\" webpack --config ./webpack/webpack.config.preload.dev.ts",
		"dev": "cross-env NODE_ENV=development NODE_OPTIONS=\"--import tsx\" webpack serve --config ./webpack/webpack.config.renderer.dev.ts",
		"postinstall": "electron-builder install-app-deps",
		"lint": "npx eslint ."
	},
	"dependencies": {
		"electron-log": "^5.4.3",
		"prop-types": "^15.8.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"sharp": "^0.34.4",
		"toastr": "^2.1.4",
		"uuid": "^14.0.1"
	},
	"devDependencies": {
		"@babel/core": "^7.24.5",
		"@babel/preset-env": "^7.24.5",
		"@babel/preset-react": "^7.24.1",
		"@babel/preset-typescript": "^7.24.1",
		"@electron/rebuild": "^4.0.2",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/better-sqlite3": "^7.6.13",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"@types/toastr": "^2.1.43",
		"@types/webpack-env": "^1.18.5",
		"babel-loader": "^10.0.0",
		"babel-plugin-add-react-displayname": "^0.0.5",
		"babel-plugin-react-compiler": "^1.0.0",
		"babel-plugin-typescript-to-proptypes": "^2.1.0",
		"copy-webpack-plugin": "^13.0.1",
		"core-js": "^3.37.1",
		"cross-env": "^10.0.0",
		"css-loader": "^7.1.1",
		"css-minimizer-webpack-plugin": "^7.0.0",
		"electron": "^43.2.0",
		"electron-builder": "^26.0.12",
		"electron-rebuild": "^3.2.9",
		"electronmon": "^2.0.3",
		"eslint": "^10.8.1",
		"html-webpack-plugin": "^5.6.0",
		"mini-css-extract-plugin": "^2.9.0",
		"postcss": "^8.4.38",
		"postcss-loader": "^8.1.1",
		"postcss-preset-env": "^10.1.2",
		"regenerator-runtime": "^0.14.1",
		"tsconfig-paths-webpack-plugin": "^4.1.0",
		"tsx": "^4.10.5",
		"typescript": "^5.4.5",
		"typescript-eslint": "^8.67.0",
		"webpack": "^5.91.0",
		"webpack-cli": "^6.0.1",
		"webpack-dev-server": "^5.0.4",
		"webpack-merge": "^6.0.1",
		"webpack-node-externals": "^3.0.0"
	},
	"electronmon": {
		"patterns": [
			"!build/**",
			"!node_modules/**",
			"!src/main/uploads/**"
		]
	},
	"browserslist": "last 2 electron versions"
}
